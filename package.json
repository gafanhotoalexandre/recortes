{
  "name": "recortes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/prepare-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "references": "node scripts/capture-poc.mjs",
    "measure": "node scripts/measure-build.mjs",
    "measure:browser": "node scripts/measure-browser.mjs",
    "measure:editing": "node scripts/measure-editing.mjs",
    "measure:export": "node scripts/measure-export.mjs",
    "measure:export:worker": "node scripts/measure-export.mjs --worker",
    "verify:export": "node scripts/verify-export.mjs",
    "check:development": "node scripts/check-development.mjs",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "compare:poc": "node scripts/compare-poc.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "pdf-lib": "1.17.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
